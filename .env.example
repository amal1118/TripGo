# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# مفتاح الخدمة (اختياري) - يُستخدم فقط داخل Route Handlers ولا يُرسل للمتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-...
# اختياريان: يتجاوزان النموذج الأول في FREE_MODELS بـ lib/openrouter.ts.
# ⚠️ كتالوج OpenRouter المجاني يتغيّر دورياً وتُسحب slugs بلا إشعار (تردّ 404).
# اتركهما فارغين للاعتماد على الافتراضيات + الاكتشاف التلقائي، أو تحقّق أولاً:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
OPENROUTER_MODEL_PLANNER=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b:free

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
