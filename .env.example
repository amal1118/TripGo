# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# مفتاح الخدمة (اختياري) - يُستخدم فقط داخل Route Handlers ولا يُرسل للمتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-...
# اختياريان: يتجاوزان النموذج الأول في FREE_MODELS بـ lib/openrouter.ts.
# ⚠️ كتالوج OpenRouter المجاني يتغيّر دورياً وتُسحب slugs بلا إشعار (تردّ 404).
# اتركهما فارغين للاعتماد على الافتراضيات + الاكتشاف التلقائي، أو تحقّق أولاً:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
OPENROUTER_MODEL_PLANNER=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b:free

# ---- البديل المدفوع (شبكة أمان) ----
# يُستدعى فقط بعد فشل كل النماذج المجانية أو عند نفاد الحصة اليومية، فتبقى
# التكلفة قريبة من الصفر مع اختفاء رسالة «تعذّر توليد الخطة» من الواجهة.
# يتطلب رصيداً في حساب OpenRouter. اضبطه على off لتعطيله كلياً.
OPENROUTER_PAID_FALLBACK=on
# ⚠️ لا تختر بالسعر وحده: qwen3.7-flash و deepseek-v4-flash و ling-3.0-flash
# و mistral-nemo أرخص لكنها علّقت حتى انتهاء المهلة على توجيه الخطة الطويل
# (قياس سبتمبر 2026). gemini-2.5-flash-lite أنهى 5/5 في أقل من 1.2s
# بتكلفة ~0.0022$ للخطة.
OPENROUTER_MODEL_PLANNER_PAID=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_CHAT_PAID=google/gemini-2.5-flash-lite

# ---- Unsplash (اختياري) ----
# بدونه تُستخدم مجموعات الصور المنتقاة في lib/images.ts، وتبقى صور البطاقات
# عامةً حسب الفئة. معه يُبحث عن `imageQuery` لكل عنصر مرة واحدة وقت توليد
# الخطة، فتُخزَّن صورة المكان الحقيقي داخل الخطة نفسها.
# أنشئ تطبيقاً في https://unsplash.com/oauth/applications وانسخ Access Key.
UNSPLASH_ACCESS_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
